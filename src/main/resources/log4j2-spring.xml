            </Policies>
            <DefaultRolloverStrategy>
                <Delete basePath="${LOG_DIR}" maxDepth="1">
                    <IfFileName glob="${HOST_IP}_dbiolog.*"/>
                    <IfAny>
                        <IfAccumulatedFileCount exceeds="336"/>
                        <IfAccumulatedFileSize exceeds="1 GB"/>
                    </IfAny>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <RollingFile name="DBIO_DAO_FILE"
                     fileName="${LOG_DIR}/${HOST_IP}_dbiolog_dao"
                     filePattern="${LOG_DIR}/${HOST_IP}_dbiolog_dao.%d{yyyy-MM-dd-HH}"
                     ignoreExceptions="true">
            <PatternLayout pattern="${APP_PATTERN}" charset="UTF-8"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
            <DefaultRolloverStrategy>
                <Delete basePath="${LOG_DIR}" maxDepth="1">
                    <IfFileName glob="${HOST_IP}_dbiolog_dao.*"/>
                    <IfAny>
                        <IfAccumulatedFileCount exceeds="336"/>
                        <IfAccumulatedFileSize exceeds="1 GB"/>
                    </IfAny>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <RollingFile name="INPUTMSG_FILE"
                     fileName="${LOG_DIR}/${HOST_IP}_inputmsglog"
                     filePattern="${LOG_DIR}/${HOST_IP}_inputmsglog.%d{yyyy-MM-dd-HH}"
                     ignoreExceptions="true">
            <PatternLayout pattern="${APP_PATTERN}" charset="UTF-8"/>
            <Policies>
