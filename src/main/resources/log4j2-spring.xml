            </Policies>
            <DefaultRolloverStrategy>
                <Delete basePath="${LOG_DIR}" maxDepth="1">
                    <IfFileName glob="${HOST_IP}_inputmsglog.*"/>
                    <IfAny>
                        <IfAccumulatedFileCount exceeds="336"/>
                        <IfAccumulatedFileSize exceeds="1 GB"/>
                    </IfAny>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <RollingFile name="OUTPUTMSG_FILE"
                     fileName="${LOG_DIR}/${HOST_IP}_outputmsglog"
                     filePattern="${LOG_DIR}/${HOST_IP}_outputmsglog.%d{yyyy-MM-dd-HH}"
                     ignoreExceptions="true">
            <PatternLayout pattern="${APP_PATTERN}" charset="UTF-8"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
            <DefaultRolloverStrategy>
                <Delete basePath="${LOG_DIR}" maxDepth="1">
                    <IfFileName glob="${HOST_IP}_outputmsglog.*"/>
                    <IfAny>
                        <IfAccumulatedFileCount exceeds="336"/>
                        <IfAccumulatedFileSize exceeds="1 GB"/>
                    </IfAny>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <RollingFile name="ASYNCDRIVER_FILE"
                     fileName="${LOG_DIR}/${HOST_IP}_asyncdriver.log"
                     filePattern="${LOG_DIR}/${HOST_IP}_asyncdriver.log.%d{yyyy-MM-dd-HH}"
                     ignoreExceptions="true">
            <PatternLayout pattern="${APP_PATTERN}" charset="UTF-8"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
            <DefaultRolloverStrategy>
                <Delete basePath="${LOG_DIR}" maxDepth="1">
                    <IfFileName glob="${HOST_IP}_asyncdriver.log.*"/>
                    <IfAny>
                        <IfAccumulatedFileCount exceeds="336"/>
                        <IfAccumulatedFileSize exceeds="1 GB"/>
                    </IfAny>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <RollingFile name="AUTH_FILE"
                     fileName="${LOG_DIR}/${HOST_IP}_authlog"
                     filePattern="${LOG_DIR}/${HOST_IP}_authlog.%d{yyyy-MM-dd-HH}"
                     ignoreExceptions="true">
            <PatternLayout pattern="${APP_PATTERN}" charset="UTF-8"/>
            <Policies>
