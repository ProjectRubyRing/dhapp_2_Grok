                        <IfAccumulatedFileSize exceeds="1 GB"/>
                    </IfAny>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <RollingFile name="ASYNCDRIVER_ERR_FILE"
                     fileName="${LOG_DIR}/${HOST_IP}_asyncdriver_${ASYNCDRIVER_ERR_FILE_ID}.err"
                     filePattern="${LOG_DIR}/${HOST_IP}_asyncdriver_${ASYNCDRIVER_ERR_FILE_ID}.err.%d{yyyy-MM-dd-HH}"
                     ignoreExceptions="true">
            <PatternLayout pattern="${APP_PATTERN}" charset="UTF-8"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
            </Policies>
            <DefaultRolloverStrategy>
                <Delete basePath="${LOG_DIR}" maxDepth="1">
                    <IfFileName glob="${HOST_IP}_asyncdriver_${ASYNCDRIVER_ERR_FILE_ID}.err.*"/>
                    <IfAny>
                        <IfAccumulatedFileCount exceeds="336"/>
                        <IfAccumulatedFileSize exceeds="1 GB"/>
                    </IfAny>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!--
            アプリのログは DEBUG まで。application.log と tracelog を含む各ファイルへ同じ内容を出す。
            additivity=true のまま root へ伝播し、コンソールと error.log（ERROR のみ）にも載せる。
        -->
        <Logger name="com.example.dhapp" level="DEBUG" additivity="true">
            <AppenderRef ref="APP_FILE"/>
            <AppenderRef ref="KEAX_FILE"/>
            <AppenderRef ref="KEAX0010_FILE"/>
            <AppenderRef ref="ERR_FILE"/>
            <AppenderRef ref="ACCESS_FILE"/>
            <AppenderRef ref="TRACE_FILE"/>
            <AppenderRef ref="DBIO_FILE"/>
            <AppenderRef ref="DBIO_DAO_FILE"/>
            <AppenderRef ref="INPUTMSG_FILE"/>
            <AppenderRef ref="OUTPUTMSG_FILE"/>
            <AppenderRef ref="ASYNCDRIVER_FILE"/>
            <AppenderRef ref="AUTH_FILE"/>
            <AppenderRef ref="CONNECTIN_FILE"/>
            <AppenderRef ref="CONNECTOUT_FILE"/>
            <AppenderRef ref="MRD_FILE"/>
            <AppenderRef ref="ASYNCDRIVER_ERR_FILE"/>
        </Logger>

        <Logger name="org.springframework.transaction" level="INFO"/>
        <Logger name="org.springframework.jdbc.core" level="INFO"/>

        <Root level="INFO">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="ERROR_FILE"/>
        </Root>
    </Loggers>
</Configuration>
