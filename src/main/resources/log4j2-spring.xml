        <RollingFile name="CONNECTOUT_FILE"
                     fileName="${LOG_DIR}/${HOST_IP}_connectoutlog"
                     filePattern="${LOG_DIR}/${HOST_IP}_connectoutlog.%d{yyyy-MM-dd-HH}"
                     ignoreExceptions="true">
            <PatternLayout pattern="${APP_PATTERN}" charset="UTF-8"/>
            <Policies>
