                        <IfAccumulatedFileSize exceeds="1 GB"/>
                    </IfAny>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- tracelog。時間ローテーション。stale file handle 調査の対象。 -->
        <RollingFile name="TRACE_FILE"
                     fileName="${LOG_DIR}/${HOST_IP}_tracelog"
                     filePattern="${LOG_DIR}/${HOST_IP}_tracelog.%d{yyyy-MM-dd-HH}"
