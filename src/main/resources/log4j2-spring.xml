            </Policies>
            <DefaultRolloverStrategy>
                <Delete basePath="${LOG_DIR}" maxDepth="1">
                    <IfFileName glob="${HOST_IP}_authlog.*"/>
                    <IfAny>
                        <IfAccumulatedFileCount exceeds="336"/>
                        <IfAccumulatedFileSize exceeds="1 GB"/>
                    </IfAny>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <RollingFile name="CONNECTIN_FILE"
                     fileName="${LOG_DIR}/${HOST_IP}_connectinlog"
                     filePattern="${LOG_DIR}/${HOST_IP}_connectinlog.%d{yyyy-MM-dd-HH}"
                     ignoreExceptions="true">
            <PatternLayout pattern="${APP_PATTERN}" charset="UTF-8"/>
            <Policies>
